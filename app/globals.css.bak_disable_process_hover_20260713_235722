.rm-process-step strong {
  display: block;
  color: #ffffff;
  font-size: 20px;
  font-weight: 600;
  line-height: 1.45;
  transition: color 0.24s ease;
}

.rm-process-step:hover span,
.rm-process-step.is-active span,
.rm-process-step:hover strong,
.rm-process-step.is-active strong {
  color: var(--rm-cyan);
}

