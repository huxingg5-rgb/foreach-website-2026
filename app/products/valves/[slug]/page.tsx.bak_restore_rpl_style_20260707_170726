          <p>Specifications</p>
          <h2>关键规格参数</h2>
        </div>

        <div className={styles.valveSpecTableWrap}>
          <table className={styles.valveSpecTable}>
            <tbody>
              {data.specs.map((item) => (
                <tr key={`${item.label}-${item.value}`}>
