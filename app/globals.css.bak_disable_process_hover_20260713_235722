.home-flow-section {
  position: relative;
  height: 220vh;
  background:
    radial-gradient(circle at 16% 18%, rgba(0, 217, 255, 0.1), transparent 30%),
    radial-gradient(circle at 82% 24%, rgba(0, 87, 184, 0.1), transparent 34%),
    linear-gradient(180deg, #ffffff 0%, #f6fbff 100%);
  overflow-x: clip;
  overflow-y: visible;
}

.home-flow-sticky {
  position: sticky;
  top: 100px;
  min-height: calc(100vh - 100px);
  padding: 30px 0 38px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0;
  overflow: hidden;
}

.home-flow-inner {
  position: relative;
  z-index: 2;
  width: min(1500px, calc(100% - 48px));
  height: 760px;
  min-height: 350px;
  display: grid;
  grid-template-columns: 0.86fr 1.14fr;
  gap: 64px;
  align-items: center;
  margin: 0 auto;
}

.home-flow-copy {
  max-width: 710px;
  transform: translateY(-30px);
}

.home-flow-title {
  margin: 0;
  color: #061a3a;
  font-size: clamp(48px, 4.8vw, 68px);
  line-height: 1.04;
  letter-spacing: 0.05em;
  font-weight: 900;
}

.home-flow-desc {
  margin: 54px 0 0;
  max-width: 620px;
  color: #5e7088;
  font-size: 15px;
  line-height: 1.85;
}

.home-flow-capability-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  margin-top: 60px;
  max-width: 560px;
}

.home-flow-capability-row span {
  padding: 8px 16px;
  border-radius: 8px;
  color: #061a3a;
  background: rgba(255, 255, 255, 0.72);
  border: 1px solid rgba(6, 26, 58, 0.12);
  font-size: 12px;
  font-weight: 500;
  cursor: pointer;
  transition:
    color 0.22s ease,
    background 0.22s ease,
    border-color 0.22s ease,
    transform 0.22s ease;
}

.home-flow-capability-row span:hover {
  color: var(--brand-accent, #00ffb2);
  background: #061a3a;
  border-color: #061a3a;
  transform: translateY(-2px);
}

.home-flow-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 18px;
  margin-top: 42px;
}

.home-flow-btn {
  height: 54px;
  padding: 0 34px;
  border-radius: 10px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(6, 26, 58, 0.12);
  color: #061a3a;
  background: rgba(255, 255, 255, 0.72);
  font-size: 15px;
  font-weight: 700;
  text-decoration: none;
  transition:
    transform 0.28s ease,
    background 0.28s ease,
    border-color 0.28s ease,
    color 0.28s ease;
}

.home-flow-btn:hover {
  transform: translateY(-2px);
  color: var(--brand-accent, #00ffb2);
  background: #061a3a;
  border-color: #061a3a;
}

