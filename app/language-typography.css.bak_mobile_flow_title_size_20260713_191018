/* =========================================================
   language-typography.css
   全站多语言排版控制文件

   文件路径：
   app/language-typography.css

   说明：
   1. 本文件只管理多语言文字的：
      - 行高 line-height
      - 字距 letter-spacing
      - 换行 overflow-wrap / word-break / hyphens
      - 最大宽度 max-width
      - 少量布局辅助 white-space / min-height

   2. 本文件不再管理：
      - Header / Top 栏 / 导航栏
      - font-size
      - font-weight
      - transform / scale
      - transition: all

   3. 这样可以避免：
      - 英文 / 西班牙语 / 法语 / 俄语切换时文字先大后小
      - Top 栏语言切换时重新计算宽度导致跳动

   4. Header / Top 栏统一交给 app/globals.css 控制
========================================================= */


/* =========================================================
   01. 三种语言排版类型变量

   compact：
   中文 / 韩文，文字较短，保持原设计密度

   standard：
   英文，字距稍微收紧，行高稍微放松

   expanded：
   西班牙语 / 法语 / 俄语，文字更长，需要更好的换行能力
========================================================= */

.site-page--compact {
  --typo-title-line-height: 1.12;
  --typo-body-line-height: 1.75;
  --typo-card-line-height: 1.6;
  --typo-title-letter-spacing: 0.02em;
}

.site-page--standard {
  --typo-title-line-height: 1.16;
  --typo-body-line-height: 1.86;
  --typo-card-line-height: 1.68;
  --typo-title-letter-spacing: -0.01em;
}

.site-page--expanded {
  --typo-title-line-height: 1.22;
  --typo-body-line-height: 1.96;
  --typo-card-line-height: 1.78;
  --typo-title-letter-spacing: -0.018em;

  overflow-wrap: break-word;
  word-break: normal;
  hyphens: auto;
}


/* =========================================================
   02. 通用 typography class

   注意：
   1. 这里不设置 font-size
   2. 字号交给各页面自己的 CSS 控制
========================================================= */

.typography-page-title,
.typography-section-title {
  line-height: var(--typo-title-line-height);
  letter-spacing: var(--typo-title-letter-spacing);
}

.typography-card-title {
  line-height: var(--typo-card-line-height);
}

.typography-body-text,
.typography-small-text {
  line-height: var(--typo-body-line-height);
}

.typography-button-text {
  line-height: 1.4;
}


