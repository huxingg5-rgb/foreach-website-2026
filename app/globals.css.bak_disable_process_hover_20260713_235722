}

.other-application-field.show {
  display: grid;
}

.verify-row,
.verify-code-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 120px;
  gap: 10px;
}

.small-btn {
  min-height: 44px;
  padding: 0 14px;
  font-size: 12px;
  font-weight: 700;
}

.verify-tip {
