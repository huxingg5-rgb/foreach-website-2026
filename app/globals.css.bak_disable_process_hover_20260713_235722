}

.field input,
.field select {
  height: 44px;
  padding: 0 12px;
  font-size: 12px;
}

.field textarea {
  min-height: 108px;
  resize: vertical;
  padding: 11px 12px;
  font-size: 12px;
  line-height: 1.72;
}

.field input:focus,
.field textarea:focus,
.field select:focus {
  border-color: var(--brand-blue);
