.quality-path-bg {
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
}

.quality-path-bg-image {
  object-fit: cover;
  object-position: right center;
  opacity: 0.4;
  filter: saturate(0.82) contrast(0.96);
}

.quality-path-bg::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  background:
    radial-gradient(circle at 14% 18%, rgba(9, 233, 180, 0.08) 0%, transparent 30%),
    radial-gradient(circle at 86% 22%, rgba(23, 51, 104, 0.05) 0%, transparent 32%),
    linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.90) 0%,
      rgba(248, 251, 254, 0.88) 48%,
      rgba(245, 248, 252, 0.92) 100%
    );
}

.quality-path-section {
  position: relative;
  width: 100%;
  padding: 118px 0 132px;
  overflow: hidden;
  color: #173368;
  background: #f5f8fc;
}

.quality-path-inner {
  position: relative;
  z-index: 2;
  width: min(1600px, calc(100% - 80px));
  margin: 0 auto;
}

.quality-path-heading {
  max-width: 980px;
  margin: 0 auto 86px;
  text-align: center;
}

.quality-path-title {
  color: #173368;
  font-size: clamp(34px, 2.6vw, 48px);
  line-height: 1.16;
  font-weight: 650;
  letter-spacing: -0.05em;
}

.quality-path-summary {
  max-width: 760px;
  margin: 22px auto 0;
  color: #5f6f86;
  font-size: 15px;
  line-height: 1.9;
}

.quality-path-timeline {
  position: relative;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  column-gap: 88px;
  row-gap: 76px;
}

.quality-path-line {
  position: absolute;
  inset: 0;
  z-index: 1;
  width: 100%;
  height: 100%;
  pointer-events: none;
  overflow: visible;
}

.quality-path-line path {
  fill: none;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.quality-path-line-base {
  stroke: rgba(23, 51, 104, 0.42);
  stroke-width: 1.5;
}

.quality-path-line-flow {
  stroke: rgba(9, 233, 180, 0.95);
  stroke-width: 2;
  stroke-dasharray: 160 1600;
  stroke-dashoffset: 0;
  opacity: 0;
  transition: opacity 0.28s ease;
}

.quality-path-timeline:hover .quality-path-line-flow {
  opacity: 0.78;
  animation: qualityPathFlow 4.8s linear infinite;
}

@keyframes qualityPathFlow {
  from {
    stroke-dashoffset: 0;
  }

  to {
    stroke-dashoffset: -1760;
  }
}

.quality-path-timeline::before {
  content: "";
  display: none;
}

.quality-path-step {
  position: relative;
  z-index: 2;
  min-height: 230px;
  padding: 52px 34px 0 0;
  cursor: default;
}

.quality-path-step:nth-of-type(4) {
  grid-column: 3;
  grid-row: 2;
}

.quality-path-step:nth-of-type(5) {
  grid-column: 2;
  grid-row: 2;
}

.quality-path-step:nth-of-type(6) {
  grid-column: 1;
  grid-row: 2;
}

.quality-path-step::before {
  content: "";
  position: absolute;
  z-index: 3;
  left: 0;
  top: 0;
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: #09e9b4;
  box-shadow: 0 0 0 10px rgba(9, 233, 180, 0.13);
  transition:
    transform 0.28s ease,
    box-shadow 0.28s ease;
}

.quality-path-step:hover::before {
  transform: scale(1.32);
  box-shadow:
    0 0 0 12px rgba(9, 233, 180, 0.16),
    0 0 24px rgba(9, 233, 180, 0.46);
}

.quality-path-index {
  display: block;
  margin-bottom: 22px;
  color: rgba(23, 51, 104, 0.34);
  font-size: 42px;
  line-height: 1;
  font-weight: 650;
  letter-spacing: -0.08em;
  transition: color 0.28s ease;
}

.quality-path-step:hover .quality-path-index {
  color: rgba(9, 233, 180, 0.95);
}

.quality-path-step-title {
  color: #173368;
  font-size: 24px;
  line-height: 1.36;
  font-weight: 650;
  letter-spacing: -0.03em;
  transition: color 0.28s ease;
}

.quality-path-step:hover .quality-path-step-title {
  color: #09e9b4;
}

.quality-path-step-desc {
  margin-top: 16px;
  color: #6b7a90;
  font-size: 15px;
  line-height: 1.82;
  transition: color 0.28s ease;
}

.quality-path-step:hover .quality-path-step-desc {
  color: #4f6078;
}

.quality-path-loop {
  position: relative;
  margin-top: 34px;
  padding: 34px 42px;
  display: grid;
  grid-template-columns: minmax(0, 0.58fr) minmax(0, 1.42fr);
  gap: 56px;
  align-items: center;
  background: rgba(255, 255, 255, 0.78);
  border: 1px solid rgba(23, 51, 104, 0.10);
  border-left: 3px solid #09e9b4;
  backdrop-filter: blur(14px);
  overflow: hidden;
  transition:
    transform 0.28s ease,
    box-shadow 0.28s ease,
    border-color 0.28s ease,
    background 0.28s ease;
}

.quality-path-loop::before {
  content: "";
  position: absolute;
  left: -40%;
  top: 0;
  width: 38%;
  height: 100%;
  pointer-events: none;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(9, 233, 180, 0.12) 48%,
    transparent 100%
  );
  opacity: 0;
  transform: skewX(-16deg);
}

.quality-path-loop:hover {
  transform: translateY(-4px);
  background: rgba(255, 255, 255, 0.92);
  border-color: rgba(9, 233, 180, 0.38);
  box-shadow: 0 16px 34px rgba(6, 26, 58, 0.08);
}

.quality-path-loop:hover::before {
  opacity: 1;
  animation: qualityLoopSweep 1.15s ease forwards;
}

@keyframes qualityLoopSweep {
  from {
    left: -42%;
  }

  to {
    left: 104%;
  }
}

.quality-path-loop-title {
  position: relative;
  z-index: 2;
  color: #173368;
  font-size: 28px;
  line-height: 1.32;
  font-weight: 650;
  letter-spacing: -0.04em;
  transition: color 0.28s ease;
}

.quality-path-loop:hover .quality-path-loop-title {
  color: #09e9b4;
}

.quality-path-loop-text {
  position: relative;
  z-index: 2;
  color: #627288;
  font-size: 15px;
  line-height: 1.9;
  transition: color 0.28s ease;
}

.quality-path-loop:hover .quality-path-loop-text {
  color: #4f6078;
}

