const threadMap = {
  M6: "M6",
  M12: "M12",
  U28: "1/4-28 UNF",
  U32: "10-32 UNF",
};

const diameterMap = {
  "05": "0.5 mm",
  "08": "0.8 mm",
  "10": "1.0 mm",
  "15": "1.5 mm",
  "20": "2.0 mm",
};

const colorMap = {
  B: "黑色",
  N: "本色",
};

const colorFilterMap = {
  B: "B - 黑色",
  N: "N - 本色",
};

const sharedDrawingMap = {
  US: "US-M6-C.pdf",
  U: "U系列-C.pdf",
  UT: "UT系列-C.pdf",
  UY: "UY系列-C.pdf",
};

function parseModel(model) {
  const parts =
    model
      .split("-")
      .filter(Boolean);

  const prefix =
    parts[0] || "";

  const materialCode =
    parts.length >= 2
      ? parts[parts.length - 2]
      : "";

  const colorCode =
    parts.length >= 1
      ? parts[parts.length - 1]
      : "";

  const diameterCode =
    [...parts]
      .reverse()
      .find((part) =>
        Object.prototype.hasOwnProperty.call(
          diameterMap,
          part
        )
      ) || "";

  const threadCodes =
    unique(
      parts.filter((part) =>
        Object.prototype.hasOwnProperty.call(
          threadMap,
          part
        )
      )
    );

  /*
   * FEMALE_THREAD_PMU_M12_FILTER_FIX
   *
   * PMU 型号中的 M12 是穿板安装螺纹，
   * 不作为液路接口螺纹参加筛选，
   * 也不显示成 M12 转 1/4-28 UNF。
   *
   * PMBSN 六角螺母的 M12 保留。
   */
  const fluidThreadCodes =
    prefix === "PMU"
      ? threadCodes.filter(
          (code) =>
            code !== "M12"
        )
      : threadCodes;

  const threads =
    fluidThreadCodes.map(
      (code) =>
        threadMap[code]
    );

  return {
    prefix,
    structure:
      structureMap[prefix] ||
      prefix,
    structureGroup:
      structureGroupMap[prefix] ||
      structureMap[prefix] ||
      prefix,
    materialCode,
    material:
      materialCode,
    colorCode,
    color:
      colorMap[colorCode] ||
      colorCode,
    colorFilter:
      colorFilterMap[colorCode] ||
      colorCode,
    diameterCode,
    diameter:
      diameterMap[diameterCode] ||
      "",
    threadCodes,
    threads,
    threadFilter:
      threads.join("|"),
  };
}

function createConnectionLine(parsed) {
  let connectionText = "";

  if (parsed.threads.length > 1) {
    connectionText =
      parsed.threads.join(" 转 ");
  } else if (
    parsed.threads.length === 1
  ) {
    connectionText =
      parsed.threads[0];
  }

  if (
    connectionText &&
    parsed.diameter
  ) {
    return `${connectionText}｜流道内径${parsed.diameter}`;
  }

  if (connectionText) {
    return connectionText;
  }

  if (parsed.diameter) {
    return `流道内径${parsed.diameter}`;
  }

  return parsed.prefix
    ? `${parsed.prefix}系列`
    : "";
}

function createCardSubtitle(parsed) {
  const line2 =
    createConnectionLine(parsed);

  const line3 = [
    parsed.material
      ? `${parsed.material}材质`
      : "",
    parsed.color,
  ]
    .filter(Boolean)
    .join("｜");

  return [
    line2,
    line3,
  ]
    .filter(Boolean)
    .join("\n");
}

