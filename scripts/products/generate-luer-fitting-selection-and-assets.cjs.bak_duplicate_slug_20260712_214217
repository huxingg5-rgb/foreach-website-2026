}

const drawingFiles = listFiles(
  drawingSourceDir,
  [".pdf"]
);

const drawingFileMap = new Map();

for (const fileName of drawingFiles) {
  drawingFileMap.set(
    normalizePdfKey(fileName),
    fileName
