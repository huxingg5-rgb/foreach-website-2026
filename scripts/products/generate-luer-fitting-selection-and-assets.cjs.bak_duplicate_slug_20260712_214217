const sheet = workbook.Sheets[SHEET_NAME];

if (!sheet) {
  throw new Error(
    `Excel 中未找到工作表：${SHEET_NAME}`
  );
}

const rows = XLSX.utils.sheet_to_json(
  sheet,
  {
    header: 1,
    defval: "",
    raw: false,
  }
);

const records = rows
  .slice(1)
  .map((row, index) => ({
    excelRow: index + 2,
    productType: text(row[0]),
    series: text(row[1]).toUpperCase(),
    itemNumber: text(row[2]),
    fullModel: text(row[3]),
    productCode: text(row[4]),
    has2DFlag: text(row[10]) === "√",
    has3DFlag: text(row[11]) === "√",
  }))
  .filter(
    (item) =>
      item.productType &&
      item.series &&
      item.itemNumber &&
      item.fullModel &&
      item.productCode
  );

if (records.length !== 151) {
  throw new Error(
    `鲁尔接头有效记录应为 151 条，当前为 ${records.length} 条。`
  );
}

