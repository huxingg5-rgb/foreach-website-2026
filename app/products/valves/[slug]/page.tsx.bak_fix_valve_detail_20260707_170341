          ))}
        </div>
      </section>

      <section className="valveDetailCta">
        <div>
          <p>Custom Inquiry</p>
          <h2>提交阀系列定制需求</h2>
          <span>
            请提供介质、压力范围、接口方式、通道数量、安装空间和控制方式，我们将协助确认合适的阀配置。
          </span>
        </div>

        <Link href="/contact">提交定制需求</Link>
      </section>
    </main>
  );
}
