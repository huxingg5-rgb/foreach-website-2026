function text(value) {
  return value == null ? "" : String(value).trim();
}

function ensureDir(targetPath) {
  fs.mkdirSync(targetPath, {
    recursive: true,
  });
}

function backupIfExists(filePath) {
  if (!fs.existsSync(filePath)) {
    return "";
  }

  const stamp = new Date()
    .toISOString()
    .replace(/[-:TZ.]/g, "")
    .slice(0, 14);

  const backupPath = `${filePath}.bak_${stamp}`;

  fs.copyFileSync(filePath, backupPath);

  return backupPath;
}

function findWorkbook() {
  if (!fs.existsSync(fittingSourceDir)) {
    throw new Error(
      `未找到数据源目录：${fittingSourceDir}`
    );
  }

  const workbooks = fs
    .readdirSync(fittingSourceDir)
    .filter(
      (fileName) =>
        fileName.endsWith(".xlsx") &&
        fileName.includes("连接件标品在售清单") &&
        !fileName.startsWith("~$")
    )
    .map((fileName) =>
      path.join(fittingSourceDir, fileName)
    )
    .sort(
      (a, b) =>
        fs.statSync(b).mtimeMs -
        fs.statSync(a).mtimeMs
    );

  if (!workbooks.length) {
    throw new Error(
      "未找到连接件标品在售清单 Excel。"
    );
  }

  return workbooks[0];
}

function listFiles(directory, extensions) {
  if (!fs.existsSync(directory)) {
    throw new Error(
      `未找到资源目录：${directory}`
    );
  }

  return fs
    .readdirSync(directory)
    .filter((fileName) =>
      extensions.some((extension) =>
        fileName.toLowerCase().endsWith(extension)
      )
    )
    .sort((a, b) =>
      a.localeCompare(b, "zh-CN", {
        numeric: true,
      })
    );
}

function normalizeFileKey(value) {
  return text(value)
    .replace(/\.[^.]+$/g, "")
    .replace(/\s+/g, "")
    .toUpperCase();
}

function normalizePdfKey(value) {
  return text(value)
    .replace(/\.pdf$/i, "")
    .replace(/\s+/g, "")
    .toUpperCase();
}

function extractModelCode(fullModel) {
  const normalized = text(fullModel);

  const match = normalized.match(
    /([A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+)$/i
  );

  if (!match) {
    return "";
  }

  return match[1].toUpperCase();
}

function slugify(value) {
  return text(value)
    .toLowerCase()
    .replace(/μ/g, "u")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");
}

