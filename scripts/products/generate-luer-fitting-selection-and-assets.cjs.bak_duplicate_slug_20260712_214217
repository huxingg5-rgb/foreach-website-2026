function parseModel(modelCode) {
  const parts = modelCode.split("-").filter(Boolean);

  const series = parts[0] || "";

  const materialCode =
    parts.length >= 2
      ? parts[parts.length - 2]
      : "";

  const colorCode =
    parts.length >= 1
      ? parts[parts.length - 1]
      : "";

  const tubeToken = parts.find((part, index) => {
    if (index === 0) return false;

    return /^(16|24|32)D?$/.test(part);
  });

  const tubeCode = tubeToken
    ? tubeToken.replace(/D$/i, "")
    : "";

  const thread =
    parts.includes("U28")
      ? "1/4-28 UNF"
      : "";

  return {
    series,
    materialCode,
    material:
      materialMap[materialCode] ||
      materialCode,
    colorCode,
    color:
      colorMap[colorCode] ||
      colorCode,
    tubeCode,
    tubeInnerDiameter:
      tubeSizeMap[tubeCode] ||
      "",
    thread,
  };
}

function createCardSubtitle({
  series,
  tubeInnerDiameter,
  thread,
  material,
  color,
}) {
  let secondLine = "";

  if (thread && tubeInnerDiameter) {
    secondLine =
      `${thread}｜适配${tubeInnerDiameter}内径软管`;
  } else if (tubeInnerDiameter) {
    secondLine =
      `适配${tubeInnerDiameter}内径软管`;
  } else {
    secondLine =
      `${series}系列`;
  }

  const thirdLine = [
    material
      ? `${material}材质`
      : "",
    color,
  ]
    .filter(Boolean)
    .join("｜");

  return [
    secondLine,
    thirdLine,
  ]
    .filter(Boolean)
    .join("\n");
}

function countBy(items, getter) {
  const result = {};

  for (const item of items) {
    const key = text(getter(item)) || "（空）";
    result[key] = (result[key] || 0) + 1;
  }

  return result;
}

function i18n(zh, en) {
  return {
    zh,
    en,
    es: en,
    fr: en,
    ko: en,
    ru: en,
  };
}

