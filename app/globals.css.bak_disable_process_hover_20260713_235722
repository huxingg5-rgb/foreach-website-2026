  cursor: pointer;
  text-decoration: none;
}



/*
 * 电视舞台继续保持可交互，
 * 但整体层级不能压住左侧按钮。
 */
.home-flow-tv-stage {
  z-index: 10;
}

/*
 * 防止舞台装饰伪元素拦截左侧点击。
 */
.home-flow-tv-stage::before,
.home-flow-tv-stage::after,
.home-flow-tv-frame::before,
.home-flow-tv-frame::after {
  pointer-events: none;
}

