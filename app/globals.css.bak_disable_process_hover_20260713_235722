  left: 0;
  bottom: 0;
  width: 22px;
  height: 2px;
  background: var(--brand-cyan);
}

.site-footer__list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  gap: 11px;
}

.site-footer__list a {
