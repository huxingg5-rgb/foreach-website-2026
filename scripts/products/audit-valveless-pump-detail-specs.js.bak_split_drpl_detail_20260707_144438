const rows = [];
const titleRows = [];
const missingProducts = [];

for (const [slug, exp] of Object.entries(expected)) {
  const item = details.find((x) => x.slug === slug);

  if (!item) {
    missingProducts.push(slug);
    continue;
  }

  titleRows.push({
    slug,
    status: normalize(item.title) === normalize(exp.title) ? "OK" : "不一致",
    expected: exp.title,
    actual: item.title
  });

  const map = specMap(item);

  for (const [label, value] of Object.entries(exp.specs)) {
    rows.push(checkValue(slug, map, label, value));
  }

  if (slug === "drpl") {
    const groupText = JSON.stringify(item.specificationGroups || []);
    for (const key of exp.groupsShouldContain || []) {
      rows.push({
        slug,
        label: `DRPL 配比配置应包含：${key}`,
        status: groupText.includes(key) ? "OK" : "缺失",
        expected: key,
        actual: groupText.includes(key) ? key : ""
      });
    }
  }
}

