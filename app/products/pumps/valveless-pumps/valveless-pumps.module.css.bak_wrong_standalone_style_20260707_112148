.page {
  background: #f6f7f9;
  color: #172033;
}

.hero {
  background: #ffffff;
  border-bottom: 1px solid #e6e9ee;
}

.breadcrumb {
  max-width: 1440px;
  margin: 0 auto;
  padding: 18px 32px 0;
  color: #6d7480;
  font-size: 14px;
}

.heroInner {
  max-width: 1440px;
  margin: 0 auto;
  padding: 34px 32px 40px;
}

.kicker {
  margin-bottom: 10px;
  color: #173368;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.12em;
}

.hero h1 {
  margin: 0;
  color: #173368;
  font-size: clamp(34px, 4vw, 54px);
  line-height: 1.12;
  font-weight: 700;
}

.description {
  margin-top: 18px;
  max-width: 980px;
  color: #3b4655;
  font-size: 17px;
  line-height: 1.75;
}

.description p {
  margin: 0 0 6px;
}

.content {
  display: grid;
  grid-template-columns: 280px minmax(0, 1fr);
  gap: 24px;
  max-width: 1440px;
  margin: 0 auto;
  padding: 28px 32px 56px;
}

.sidebar {
  min-width: 0;
}

.sidebarBlock {
  position: sticky;
  top: 96px;
  background: #ffffff;
  border: 1px solid #e4e8ef;
  padding: 22px;
}

.sidebarBlock h2 {
  margin: 0 0 10px;
  color: #173368;
  font-size: 20px;
  line-height: 1.3;
}

.sidebarBlock p {
  margin: 0;
  color: #586273;
  font-size: 14px;
  line-height: 1.7;
}

.sidebarTag {
  display: inline-flex;
  align-items: center;
  margin-top: 18px;
  padding: 7px 12px;
  border: 1px solid rgba(23, 51, 104, 0.18);
  background: rgba(23, 51, 104, 0.04);
  color: #173368;
  font-size: 13px;
  font-weight: 600;
}

.mainList {
  min-width: 0;
}

.resultBar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 18px;
  padding: 0 2px;
}

.resultBar strong {
  color: #173368;
  font-size: 18px;
}

.resultBar span {
  color: #6a7280;
  font-size: 14px;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22px;
}

.card {
  overflow: hidden;
  background: #ffffff;
  border: 1px solid #e3e7ee;
  transition: border-color 0.18s ease, transform 0.18s ease;
}

.card:hover {
  border-color: rgba(9, 233, 180, 0.9);
  transform: translateY(-1px);
}

.imageWrap {
  display: block;
  position: relative;
  background: #f2f4f7;
  border-bottom: 1px solid #e8ebf0;
  aspect-ratio: 16 / 10;
}

.image {
  width: 100%;
  height: 100%;
  object-fit: contain;
  padding: 18px;
}

.cardBody {
  padding: 22px 22px 20px;
}

.cardMeta {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 12px;
}

.cardMeta span {
  padding: 5px 9px;
  background: #f3f6fa;
  color: #506070;
  font-size: 12px;
  line-height: 1;
}

.card h2 {
  margin: 0 0 12px;
  font-size: 22px;
  line-height: 1.25;
}

.card h2 a {
  color: #173368;
  text-decoration: none;
}

.card:hover h2 a {
  color: #09e9b4;
}

.cardDesc {
  min-height: 78px;
}

.cardDesc p {
  margin: 0 0 4px;
  color: #4a5565;
  font-size: 15px;
  line-height: 1.55;
}

.actions {
  display: flex;
  gap: 10px;
  margin-top: 18px;
}

.primaryBtn,
.secondaryBtn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 38px;
  padding: 0 16px;
  border: 1px solid #173368;
  font-size: 14px;
  font-weight: 600;
  text-decoration: none;
  transition: background 0.16s ease, color 0.16s ease, border-color 0.16s ease;
}

.primaryBtn {
  background: #173368;
  color: #09e9b4;
}

.secondaryBtn {
  background: #ffffff;
  color: #173368;
}

.primaryBtn:hover,
.secondaryBtn:hover {
  background: #173368;
  color: #09e9b4;
  border-color: #173368;
}

@media (max-width: 980px) {
  .content {
    grid-template-columns: 1fr;
  }

  .sidebar {
    display: none;
  }

  .grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 640px) {
  .breadcrumb,
  .heroInner,
  .content {
    padding-left: 18px;
    padding-right: 18px;
  }

  .resultBar {
    align-items: flex-start;
    flex-direction: column;
    gap: 6px;
  }

  .actions {
    flex-direction: column;
  }
}