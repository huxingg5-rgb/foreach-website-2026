  .filter(Boolean);

const usedImageFiles = new Set();
const usedDrawingFiles = new Set();

const missingImages = [];
const missingDrawings = [];

const assetMap = {};
const products = [];

records.forEach((record, index) => {
  const modelCode =
    extractModelCode(record.fullModel);

  if (!modelCode) {
    throw new Error(
      `第 ${record.excelRow} 行无法解析恒永达型号：${record.fullModel}`
    );
  }

  const parsed = parseModel(modelCode);

  if (!parsed.series) {
    throw new Error(
      `第 ${record.excelRow} 行无法解析系列：${modelCode}`
    );
  }

  const productName =
    productNameBySeries[parsed.series] ||
    record.productType ||
    "鲁尔接头";

  const seriesFilterLabel =
    seriesFilterLabelMap[parsed.series] ||
    parsed.series;

  const imageSourceFile =
    imageFileMap.get(
      normalizeFileKey(modelCode)
    ) || "";

  let imageCard = "";

  if (imageSourceFile) {
    const targetImageFile =
      imageSourceFile;

    fs.copyFileSync(
      path.join(
        imageSourceDir,
        imageSourceFile
      ),
      path.join(
        imageTargetDir,
        targetImageFile
      )
    );

    usedImageFiles.add(imageSourceFile);

    imageCard =
      `/images/products/fittings/${PRODUCT_TYPE_ID}/products/${targetImageFile}`;
  } else {
    missingImages.push({
      excelRow: record.excelRow,
      productCode: record.productCode,
      model: modelCode,
      fullModel: record.fullModel,
    });
  }

  let drawingSourceFile = "";

  const sharedDrawing =
    sharedDrawingBySeries[parsed.series];

  if (
    sharedDrawing &&
    drawingFileMap.has(
      normalizePdfKey(sharedDrawing)
    )
  ) {
    drawingSourceFile =
      drawingFileMap.get(
        normalizePdfKey(sharedDrawing)
      );
  } else {
    const itemDrawingKey =
      normalizePdfKey(
        `${record.itemNumber}-C`
      );

    drawingSourceFile =
      drawingFileMap.get(
        itemDrawingKey
      ) || "";
  }

  let drawingPdfUrl = "";

  if (drawingSourceFile) {
    fs.copyFileSync(
      path.join(
        drawingSourceDir,
        drawingSourceFile
      ),
      path.join(
        drawingTargetDir,
        drawingSourceFile
      )
    );

    usedDrawingFiles.add(
      drawingSourceFile
    );

    drawingPdfUrl =
      `/documents/products/fittings/${PRODUCT_TYPE_ID}/drawings/${drawingSourceFile}`;
  } else {
    missingDrawings.push({
      excelRow: record.excelRow,
      productCode: record.productCode,
      model: modelCode,
      itemNumber: record.itemNumber,
      series: parsed.series,
      has2DFlag: record.has2DFlag,
    });
  }

  const slug = slugify(modelCode);

  const filters = {
    filter01: record.productType,
    filter02: seriesFilterLabel,
    filter03: parsed.tubeInnerDiameter,
    filter04: parsed.thread,
    filter05: parsed.material,
    filter06: parsed.color,
  };

  Object.keys(filters).forEach((key) => {
    if (!filters[key]) {
      delete filters[key];
    }
  });

  const cardSubtitle =
    createCardSubtitle({
      series: parsed.series,
      tubeInnerDiameter:
        parsed.tubeInnerDiameter,
      thread: parsed.thread,
      material: parsed.material,
      color: parsed.color,
    });

  products.push({
    productId: record.productCode,
    categoryId: "fittings",
    productTypeId: PRODUCT_TYPE_ID,
    seriesId:
      parsed.series.toLowerCase(),
    cardTitle: {
      zh: productName,
      en: productName,
    },
    cardSubtitle: {
      zh: cardSubtitle,
      en: cardSubtitle,
    },
    filters,
    imageCard,
    detailSlug: slug,
    status: "active",
    sortOrder: index + 1,
    searchKeywords: {
      zh: [
        record.fullModel,
        modelCode,
        record.productCode,
        record.itemNumber,
        record.productType,
        parsed.series,
        productName,
        parsed.tubeInnerDiameter,
        parsed.thread,
        parsed.material,
        parsed.color,
      ]
        .filter(Boolean)
        .join(" "),
      en: [
        modelCode,
        record.productCode,
        record.itemNumber,
        parsed.series,
        parsed.tubeInnerDiameter,
        parsed.thread,
        parsed.material,
      ]
        .filter(Boolean)
        .join(" "),
    },
  });

  assetMap[record.productCode] = {
    productCode: record.productCode,
    itemNumber: record.itemNumber,
    fullModel: record.fullModel,
    model: modelCode,
    slug,
    series: parsed.series,
    imageCard,
    drawingPdfUrl,
    imageSourceFile,
    drawingSourceFile,
    has2DFlag: record.has2DFlag,
    has3DFlag: record.has3DFlag,
  };
});

