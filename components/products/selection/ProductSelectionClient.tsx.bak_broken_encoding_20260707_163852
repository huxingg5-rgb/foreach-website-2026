      });
    }

    FILTER_KEYS.forEach((filterKey) => {
      const values = selectedFilters[filterKey];

      if (!values || values.size === 0) return;

      values.forEach((value) => {
        tags.push({
          key: filterKey,
          value,
          label: value,
        });
