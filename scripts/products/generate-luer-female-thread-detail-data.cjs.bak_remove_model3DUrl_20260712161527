function text(value) {
  return value == null
    ? ""
    : String(value).trim();
}

function ensureParent(filePath) {
  fs.mkdirSync(
    path.dirname(filePath),
    {
      recursive: true,
    }
  );
}

function backupIfExists(filePath) {
  if (!fs.existsSync(filePath)) {
    return "";
  }

  const stamp = new Date()
    .toISOString()
    .replace(/[-:TZ.]/g, "")
    .slice(0, 14);

  const backupPath =
    `${filePath}.bak_${stamp}`;

  fs.copyFileSync(
    filePath,
    backupPath
  );

  return backupPath;
}

function readJson(
  filePath,
  fallback
) {
  if (!fs.existsSync(filePath)) {
    return fallback;
  }

  return JSON.parse(
    fs.readFileSync(
      filePath,
      "utf8"
    )
  );
}

function extractJsonArray(
  source,
  exportName
) {
  const marker =
    `export const ${exportName}`;

  const markerIndex =
    source.indexOf(marker);

  if (markerIndex < 0) {
    throw new Error(
      `未找到导出：${exportName}`
    );
  }

  const assignmentIndex =
    source.indexOf(
      "=",
      markerIndex
    );

  if (assignmentIndex < 0) {
    throw new Error(
      `${exportName} 没有找到赋值符号。`
    );
  }

  const arrayStart =
    source.indexOf(
      "[",
      assignmentIndex
    );

  if (arrayStart < 0) {
    throw new Error(
      `${exportName} 没有数组起点。`
    );
  }

  let depth = 0;
  let quote = "";
  let escaped = false;

  for (
    let index = arrayStart;
    index < source.length;
    index += 1
  ) {
    const char =
      source[index];

    if (quote) {
      if (escaped) {
        escaped = false;
        continue;
      }

      if (char === "\\") {
        escaped = true;
        continue;
      }

      if (char === quote) {
        quote = "";
      }

      continue;
    }

    if (
      char === '"' ||
      char === "'"
    ) {
      quote = char;
      continue;
    }

    if (char === "[") {
      depth += 1;
      continue;
    }

    if (char === "]") {
      depth -= 1;

      if (depth === 0) {
        return JSON.parse(
          source.slice(
            arrayStart,
            index + 1
          )
        );
      }
    }
  }

  throw new Error(
    `${exportName} 数组没有正常结束。`
  );
}

function localizedText(value) {
  if (typeof value === "string") {
    return text(value);
  }

  return text(
    value?.zh ||
    value?.en ||
    ""
  );
}

function normalizeSlug(value) {
  return text(value)
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");
}

function cleanFilterValue(value) {
  return text(value)
    .split("|")
    .map(
      (item) =>
        item.trim()
    )
    .filter(Boolean)
    .join("、");
}

function removeCodePrefix(value) {
  return cleanFilterValue(value)
    .replace(
      /^[A-Z0-9]+\s*-\s*/,
      ""
    );
}

function getSeriesCode(product) {
  const seriesId =
    text(product.seriesId)
      .toUpperCase();

  if (seriesId) {
    return seriesId;
  }

  return localizedText(
    product.cardTitle
  )
    .split("-")[0]
    .toUpperCase();
}

function toAssetEntries(rawMap) {
  if (Array.isArray(rawMap)) {
    return rawMap;
  }

  if (
    rawMap &&
    typeof rawMap === "object"
  ) {
    return Object.values(
      rawMap
    );
  }

  return [];
}

function findAsset(
  assetEntries,
  productCode,
  model
) {
  const code =
    text(productCode);

  const upperModel =
    text(model).toUpperCase();

  return (
    assetEntries.find(
      (item) =>
        text(
          item?.productCode ||
          item?.productId
        ) === code
    ) ||
    assetEntries.find(
      (item) =>
        text(
          item?.model ||
          item?.fullModel ||
          item?.foreachModel
        ).toUpperCase() ===
        upperModel
    ) ||
    {}
  );
}

function firstNonEmpty(
  object,
  keys
) {
  for (const key of keys) {
    const value =
      text(object?.[key]);

    if (value) {
      return value;
    }
  }

  return "";
}

function getImagePath(
  product,
  asset
) {
  return (
    text(product.imageCard) ||
    firstNonEmpty(
      asset,
      [
        "imageCard",
        "mainImage",
        "image",
        "imageUrl",
      ]
    )
  );
}

function getDrawingPath(asset) {
  return firstNonEmpty(
    asset,
    [
      "drawingPdfUrl",
      "drawingUrl",
