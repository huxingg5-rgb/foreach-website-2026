function createRouteMapSource(
  target,
  details
) {
  const byProductCode = {};
  const byModel = {};

  for (const detail of details) {
    byProductCode[
      detail.productCode
    ] =
      detail.detailHref;

    byModel[
      detail.model
    ] =
      detail.detailHref;
  }

  const prefix =
    target.id ===
    "luer-fittings"
      ? "luerFitting"
      : "femaleThreadAdapter";

  return `/*
 * 自动生成：${target.productTypeLabel}详情路由映射
 *
 * 数据源：
 * ${path.relative(root, target.detailOutputPath).replace(/\\/g, "/")}
 *
 * 请勿手工修改。
 */

export const ${prefix}DetailHrefByProductCode:
  Record<string, string> =
${JSON.stringify(byProductCode, null, 2)};

export const ${prefix}DetailHrefByModel:
  Record<string, string> =
${JSON.stringify(byModel, null, 2)};
`;
}

const report = {
  generatedAt:
    new Date().toISOString(),

  targets: [],
};

for (const target of targets) {
  if (
    !fs.existsSync(
      target.selectionPath
    )
  ) {
    throw new Error(
      `未找到选型数据：${target.selectionPath}`
    );
  }

  const selectionSource =
    fs.readFileSync(
      target.selectionPath,
      "utf8"
    );

  const products =
    extractJsonArray(
      selectionSource,
      target.exportName
    );

  const rawAssetMap =
    readJson(
      target.assetMapPath,
      {}
    );

  const assetEntries =
    toAssetEntries(
      rawAssetMap
    );

  const details =
    products.map(
      (product) => {
        const model =
          localizedText(
            product.cardTitle
          );

        const productCode =
          text(
            product.productCode ||
            product.productId
          );

        const asset =
          findAsset(
            assetEntries,
            productCode,
            model
          );

        return target.id ===
          "luer-fittings"
          ? createLuerDetail(
              product,
              asset
            )
          : createFemaleDetail(
              product,
              asset
            );
      }
    );

  const expectedCount =
    target.id ===
    "luer-fittings"
      ? 151
      : 24;

  if (
    details.length !==
    expectedCount
  ) {
    throw new Error(
      `${target.productTypeLabel}详情数量错误：${details.length}/${expectedCount}`
    );
  }

  const slugCounts = {};

  for (const detail of details) {
    slugCounts[detail.slug] =
      (slugCounts[detail.slug] || 0) +
      1;
  }

  const duplicateSlugs =
    Object.entries(
      slugCounts
    ).filter(
      ([, count]) =>
        count > 1
    );

  if (
    duplicateSlugs.length
  ) {
    throw new Error(
      `${target.productTypeLabel}存在重复slug：${JSON.stringify(duplicateSlugs)}`
    );
  }

  ensureParent(
    target.detailOutputPath
  );

  ensureParent(
    target.routeMapOutputPath
  );

  const backups = [
    backupIfExists(
      target.detailOutputPath
    ),
    backupIfExists(
      target.routeMapOutputPath
    ),
  ].filter(Boolean);

  fs.writeFileSync(
    target.detailOutputPath,
    JSON.stringify(
      details,
      null,
      2
    ) + "\n",
    "utf8"
  );

  fs.writeFileSync(
    target.routeMapOutputPath,
    createRouteMapSource(
      target,
      details
    ),
    "utf8"
  );

  report.targets.push({
    productTypeId:
      target.id,

    count:
      details.length,

    withImage:
      details.filter(
        (item) =>
          item.mainImage
      ).length,

    withDrawing:
      details.filter(
        (item) =>
          item.drawingPdfUrl
      ).length,

    withModel3d:
      details.filter(
        (item) =>
          item.model3dUrl
      ).length,

    detailOutputPath:
      target.detailOutputPath,

    routeMapOutputPath:
      target.routeMapOutputPath,

    backups,

    samples:
      details
        .slice(0, 3)
        .map(
          (item) => ({
            model:
              item.model,

            name:
              item.name,

            description:
              item.description,

            specs:
              item.specs,

            detailHref:
              item.detailHref,
          })
        ),
  });
}

