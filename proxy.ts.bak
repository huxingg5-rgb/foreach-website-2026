// proxy.ts
// 根据浏览器语言进行首次语言推荐
//
// 说明：
// 1. 只在用户访问首页 "/" 时判断浏览器语言
// 2. 如果用户访问 /en、/es、/fr、/ko、/ru，说明用户已经明确选择语言，不再自动跳转
// 3. 用户手动选择语言后，会写入 Cookie
// 4. 后续用户再访问 "/"，优先使用 Cookie 中保存的语言
// 5. 浏览器语言匹配不到时，默认进入英文 /en

import { NextRequest, NextResponse } from "next/server"; // 引入 Next.js 请求和响应工具

import {
  defaultLocale, // 默认语言，当前是 zh-CN
  getLanguageHomeHref, // 根据语言获取首页路径
  type LocaleCode, // 官网统一语言类型
} from "@/data/languages"; // 读取统一语言配置

import { getLocaleByAcceptLanguage } from "@/data/browser-locale"; // 根据浏览器语言获取推荐语言
export const runtime = "edge";  
// 语言偏好 Cookie 名称
// 说明：用户访问 /en、/fr 等语言页时，会写入这个 Cookie
const LOCALE_COOKIE_NAME = "foreach_locale";

// 根据当前路径判断是否已经是某个语言版本
function getLocaleFromPathname(pathname: string): LocaleCode | null {
  if (pathname === "/") {
    return defaultLocale;
  }

  if (pathname === "/en" || pathname.startsWith("/en/")) {
    return "en";
  }

  if (pathname === "/es" || pathname.startsWith("/es/")) {
    return "es";
  }

  if (pathname === "/fr" || pathname.startsWith("/fr/")) {
    return "fr";
  }

  if (pathname === "/ko" || pathname.startsWith("/ko/")) {
    return "ko";
  }

  if (pathname === "/ru" || pathname.startsWith("/ru/")) {
    return "ru";
  }

  return null;
}

// 校验 Cookie 里的语言是否有效
function normalizeLocaleCookie(value: string | undefined): LocaleCode | null {
  if (value === "zh-CN") return "zh-CN";
  if (value === "en") return "en";
  if (value === "es") return "es";
  if (value === "fr") return "fr";
  if (value === "ko") return "ko";
  if (value === "ru") return "ru";

  return null;
}

// Next.js Middleware 主函数
export function proxy(request: NextRequest) {
  const { pathname } = request.nextUrl; // 获取当前访问路径

  const currentPathLocale = getLocaleFromPathname(pathname); // 判断当前路径是否已经带语言

  // 情况一：用户访问了明确语言路径，例如 /en、/es、/fr、/ko、/ru
  // 说明用户已经选择语言，不再自动跳转，只记录 Cookie
  if (currentPathLocale && pathname !== "/") {
    const response = NextResponse.next(); // 继续正常访问页面

    response.cookies.set(LOCALE_COOKIE_NAME, currentPathLocale, {
      path: "/", // 整站可用
      maxAge: 60 * 60 * 24 * 180, // 保存 180 天
      sameSite: "lax", // 常规站内跳转够用
    });

    return response;
  }

  // 情况二：不是访问首页 "/"，例如 /products、/about
  // 不做语言跳转，避免影响后续页面和静态资源
  if (pathname !== "/") {
    return NextResponse.next();
  }

  // 情况三：用户访问首页 "/"，先看是否有手动选择过语言
  const savedLocale = normalizeLocaleCookie(
    request.cookies.get(LOCALE_COOKIE_NAME)?.value
  );

  // 用户以前选择过非中文语言，则跳到对应语言首页
  if (savedLocale && savedLocale !== defaultLocale) {
    const redirectUrl = request.nextUrl.clone();

    redirectUrl.pathname = getLanguageHomeHref(savedLocale);

    return NextResponse.redirect(redirectUrl);
  }

  // 用户以前选择过中文，则保持在 "/"
  if (savedLocale === defaultLocale) {
    return NextResponse.next();
  }

  // 情况四：没有 Cookie 时，读取浏览器语言
  const acceptLanguage = request.headers.get("accept-language");

  const browserLocale = getLocaleByAcceptLanguage(acceptLanguage);

  // 浏览器语言不是中文，则跳到对应语言首页
  if (browserLocale !== defaultLocale) {
    const redirectUrl = request.nextUrl.clone();

    redirectUrl.pathname = getLanguageHomeHref(browserLocale);

    const response = NextResponse.redirect(redirectUrl);

    response.cookies.set(LOCALE_COOKIE_NAME, browserLocale, {
      path: "/",
      maxAge: 60 * 60 * 24 * 180,
      sameSite: "lax",
    });

    return response;
  }

  // 浏览器语言是中文，则保持中文首页 "/"
  const response = NextResponse.next();

  response.cookies.set(LOCALE_COOKIE_NAME, defaultLocale, {
    path: "/",
    maxAge: 60 * 60 * 24 * 180,
    sameSite: "lax",
  });

  return response;
}

// Middleware 匹配范围
// 说明：
// 1. 排除 api 路由
// 2. 排除 _next 静态资源
// 3. 排除图片、图标、CSS、JS 等静态文件
// 4. 避免语言判断影响资源加载
export const config = {
  matcher: [
    "/((?!api|_next/static|_next/image|favicon.ico|robots.txt|sitemap.xml|.*\\..*).*)",
  ],
}; 