.home-panel-index {
  display: block;
  margin: 0 0 18px;
  color: rgba(255, 255, 255, 0.58);
  font-size: 12px;
  font-weight: 900;
  letter-spacing: 0.12em;
}

.home-panel-title {
  margin: 0;
  color: #ffffff;
  font-size: clamp(24px, 2vw, 34px);
  line-height: 1.16;
  font-weight: 900;
  letter-spacing: -0.04em;
  white-space: nowrap;
}

.home-panel-line {
  width: 52px;
  height: 2px;
  margin-top: 22px;
  background: rgba(255, 255, 255, 0.52);
  transition:
    width 0.35s ease,
    background 0.35s ease;
}

.home-panel-brief,
.home-panel-detail,
.home-panel-arrow {
  opacity: 0;
  transform: translateY(18px);
  pointer-events: none;
  transition:
    opacity 0.46s ease 0.12s,
    transform 0.46s ease 0.12s;
}

.home-panel-brief {
  margin: 24px 0 0;
  max-width: 390px;
  color: rgba(255, 255, 255, 0.82);
  font-size: 15px;
  line-height: 1.75;
}

.home-panel-detail {
  max-width: 460px;
  max-height: 0;
  margin: 0;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.7);
  font-size: 12px;
  line-height: 1.75;
  transition:
    max-height 0.52s ease 0.16s,
    opacity 0.46s ease 0.16s,
    transform 0.46s ease 0.16s,
    margin 0.46s ease 0.16s;
}

.home-panel-arrow {
  width: 52px;
  height: 52px;
  margin-top: 28px;
  border-radius: 999px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.12);
  border: 1px solid rgba(255, 255, 255, 0.22);
  font-size: 22px;
}

