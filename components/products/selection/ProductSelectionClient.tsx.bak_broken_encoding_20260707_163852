function makeDetailHref(product: ProductSelectionProduct) {
  
  const isValveProduct = product.categoryId === "valves";

  if (isValveProduct) {
    /*
      阀系列详情链接兜底逻辑。

      阀系列现在按无阀泵同款层级处理：
      - productTypeId = valves
      - seriesId = rotary-valves / high-pressure-valves / solenoid-valves

      所以详情页 slug 不能再从 productTypeId 取，
      而应该优先读取 detailHref，其次读取 slug / seriesId。
    */
    const valveProduct = product as ProductSelectionProduct & {
      slug?: string;
      seriesId?: string;
      detailHref?: string;
      href?: string;
      id?: string;
      productId?: string;
    };

    const valveSlug =
      valveProduct.slug ||
      valveProduct.seriesId ||
      valveProduct.productId ||
      valveProduct.id ||
      "rotary-valves";

    return (
      valveProduct.detailHref ||
      valveProduct.href ||
      `/products/valves/${valveSlug}`
    );
  }

  const isValvelessPump =
    product.categoryId === "pumps" &&
    ["valveless-pump", "valveless-pumps"].includes(product.productTypeId);

  const isSyringePump =
    product.categoryId === "pumps" &&
    ["syringe-pump", "syringe-pumps"].includes(product.productTypeId);

  if (isValvelessPump) {
    const rawSlug =
      (product as any).detailSlug ||
      (product as any).seriesSlug ||
      (product as any).seriesId ||
      product.productId;

    const slug = String(rawSlug || "")
      .split("/")
      .filter(Boolean)
      .pop();

    return slug
      ? `/products/pumps/valveless-pumps/${slug}`
