  margin-bottom: 82px;
  text-align: center;
}

.about-foreach-honor-title h2 {
  color: #173368;
  font-size: clamp(40px, 3.6vw, 58px);
  line-height: 1.1;
  font-weight: 850;
  letter-spacing: 0;
}

.about-foreach-honor-layout {
  display: grid;
  grid-template-columns: minmax(280px, 0.28fr) minmax(0, 0.72fr);
  gap: clamp(44px, 5vw, 84px);
  align-items: center;
}

.about-foreach-honor-summary {
  min-width: 0;
  margin-top: 0;
  padding: 28px 0 0;
}

.about-foreach-honor-summary h3 {
  color: #173368;
  font-size: clamp(30px, 2.6vw, 44px);
  line-height: 1.18;
  font-weight: 750;
  letter-spacing: 0;
}

.about-foreach-honor-summary-stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: clamp(20px, 2.5vw, 42px);
  max-width: 560px;
  margin-top: clamp(42px, 5vw, 68px);
}

.about-foreach-honor-summary-stat {
  min-width: 0;
  padding-right: 0;
  border-right: none;
}

.about-foreach-honor-summary-number {
  color: #173368;
  font-size: clamp(56px, 5.4vw, 86px);
  font-weight: 850;
  line-height: 0.95;
  letter-spacing: 0;
}

.about-foreach-honor-summary-plus {
  color: #173368;
  margin-left: 4px;
  font-size: 0.34em;
  font-weight: 850;
}

.about-foreach-honor-summary-label {
  margin-top: 14px;
  color: #364152;
  font-size: 15px;
  font-weight: 750;
  line-height: 1.35;
}

.about-foreach-honor-board {
  min-width: 0;
}

.about-foreach-honor-top-row {
  display: grid;
  grid-template-columns: minmax(360px, 1.78fr) repeat(2, minmax(142px, 0.78fr));
  gap: clamp(18px, 1.6vw, 28px);
  align-items: stretch;
}

.about-foreach-honor-main-cert {
  width: 100%;
  height: auto;
  aspect-ratio: 1.43 / 1;
  margin: 0;
  border: 8px solid #454b55;
  background: #ffffff;
  box-shadow: 0 18px 42px rgba(7, 26, 58, 0.08);
}

.about-foreach-honor-main-cert::before {
  display: none;
}

.about-foreach-honor-main-cert-image,
.about-foreach-honor-iso-cert,
.about-foreach-honor-middle-image,
.about-foreach-honor-a4-image {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.about-foreach-honor-iso-cert {
  min-width: 0;
  background: #f5df53;
  box-shadow: 0 12px 30px rgba(7, 26, 58, 0.06);
}

.about-foreach-honor-middle-row {
  display: grid;
  grid-template-columns: minmax(320px, 1.32fr) minmax(210px, 0.86fr) minmax(260px, 1fr);
  gap: clamp(22px, 2vw, 32px);
  align-items: stretch;
  margin-top: clamp(40px, 4vw, 58px);
}

.about-foreach-honor-middle-image {
  height: clamp(150px, 13vw, 230px);
  background: #f7f8fb;
  box-shadow: 0 12px 30px rgba(7, 26, 58, 0.06);
}

.about-foreach-honor-a4-row {
  display: grid;
  grid-template-columns: repeat(8, minmax(0, 1fr));
  gap: clamp(14px, 1.35vw, 24px);
  width: 100%;
  margin-top: clamp(56px, 5vw, 78px);
  align-items: start;
}

.about-foreach-honor-a4-card {
  min-width: 0;
  text-align: center;
}

.about-foreach-honor-a4-image-wrap {
  position: relative;
  width: 100%;
  aspect-ratio: 210 / 297;
  overflow: hidden;
  background: #ffffff;
  border: 1px solid rgba(17, 24, 39, 0.08);
  box-shadow: 0 14px 32px rgba(7, 26, 58, 0.06);
}

.about-foreach-honor-a4-image-wrap::before {
  display: none;
}

@media (max-width: 1280px) {
  .about-foreach-honor-layout {
    grid-template-columns: minmax(240px, 0.32fr) minmax(0, 0.68fr);
    gap: 40px;
  }

  .about-foreach-honor-top-row {
    grid-template-columns: minmax(300px, 1.7fr) repeat(2, minmax(120px, 0.72fr));
  }

  .about-foreach-honor-middle-row {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

@media (max-width: 980px) {
  .about-foreach-honor-layout {
    grid-template-columns: 1fr;
  }

  .about-foreach-honor-summary {
    padding-top: 0;
    text-align: center;
  }

  .about-foreach-honor-summary-stats {
    margin-right: auto;
    margin-left: auto;
  }

  .about-foreach-honor-top-row {
    grid-template-columns: minmax(0, 1.4fr) repeat(2, minmax(0, 0.8fr));
  }

  .about-foreach-honor-middle-row {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .about-foreach-honor-a4-row {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
}

@media (max-width: 640px) {
  .about-foreach-honor-section {
    padding: 72px 0;
  }

  .about-foreach-honor-title {
    margin-bottom: 46px;
  }

  .about-foreach-honor-layout {
    gap: 36px !important;
  }

  .about-foreach-honor-summary-stats {
    grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
    gap: 10px !important;
    width: 100% !important;
    max-width: 100% !important;
    margin: 34px 0 0 !important;
    padding: 0 !important;
    overflow: visible !important;
  }

  .about-foreach-honor-summary-number {
    font-size: 38px !important;
  }

  .about-foreach-honor-summary-label {
    font-size: 12px !important;
    white-space: normal !important;
  }

  .about-foreach-honor-top-row {
    grid-template-columns: 1fr 1fr !important;
    gap: 12px !important;
  }

  .about-foreach-honor-main-cert {
    grid-column: 1 / -1;
    border-width: 5px;
  }

  .about-foreach-honor-iso-cert {
    aspect-ratio: 210 / 297;
    height: auto !important;
  }

  .about-foreach-honor-middle-row {
    grid-template-columns: 1fr !important;
    gap: 14px !important;
    margin-top: 22px;
  }

  .about-foreach-honor-middle-image {
    height: auto !important;
    aspect-ratio: 16 / 9;
  }

  .about-foreach-honor-a4-row {
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    gap: 12px !important;
    width: 100% !important;
    max-width: 100% !important;
    margin: 36px 0 0 !important;
    padding: 0 !important;
    overflow: visible !important;
  }
}
