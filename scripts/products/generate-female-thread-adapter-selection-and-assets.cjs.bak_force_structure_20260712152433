records.forEach(
  (record, index) => {
    const model =
      extractModelCode(
        record.fullModel
      );

    if (!model) {
      throw new Error(
        `第 ${record.excelRow} 行无法解析恒永达型号：${record.fullModel}`
      );
    }

    const parsed =
      parseModel(model);

    if (
      !structureMap[
        parsed.prefix
      ]
    ) {
      throw new Error(
        `第 ${record.excelRow} 行发现未知型号前缀：${parsed.prefix}`
      );
    }

    const imageFile =
      imageFileMap.get(
        normalizeBaseName(model)
      ) || "";

    let imageCard = "";

    if (imageFile) {
      fs.copyFileSync(
        path.join(
          imageSourceDir,
          imageFile
        ),
        path.join(
          imageTargetDir,
          imageFile
        )
      );

      usedImages.add(
        imageFile
      );

      imageCard =
        `/images/products/fittings/${PRODUCT_TYPE_ID}/products/${imageFile}`;
    } else {
      missingImages.push({
        excelRow:
          record.excelRow,
        productCode:
          record.productCode,
        itemNumber:
          record.itemNumber,
        model,
      });
    }

    const exactDrawingName =
      `${record.itemNumber}-C.pdf`;

    const drawingCandidate =
      drawingFileMap.get(
        normalizeBaseName(
          exactDrawingName
        )
      ) ||
      (
        sharedDrawingMap[
          parsed.prefix
        ]
          ? drawingFileMap.get(
              normalizeBaseName(
                sharedDrawingMap[
                  parsed.prefix
                ]
              )
            )
          : ""
      ) ||
      "";

    let drawingPdfUrl = "";

    if (drawingCandidate) {
      fs.copyFileSync(
        path.join(
          drawingSourceDir,
          drawingCandidate
        ),
        path.join(
          drawingTargetDir,
          drawingCandidate
        )
      );

      usedDrawings.add(
        drawingCandidate
      );

      drawingPdfUrl =
        `/documents/products/fittings/${PRODUCT_TYPE_ID}/drawings/${drawingCandidate}`;
    } else {
      missingDrawings.push({
        excelRow:
          record.excelRow,
        productCode:
          record.productCode,
        itemNumber:
          record.itemNumber,
        model,
        prefix:
          parsed.prefix,
      });
    }

    const filters = {
      filter01:
        parsed.structureGroup,
      filter02:
        parsed.threadFilter,
      filter03:
        parsed.diameter,
      filter04:
        parsed.material,
      filter05:
        parsed.colorFilter,
    };

    Object
      .keys(filters)
      .forEach((key) => {
        if (!filters[key]) {
          delete filters[key];
        }
      });

    const slug =
      slugify(model);

    products.push({
      productId:
        record.productCode,
      categoryId:
        "fittings",
      productTypeId:
        PRODUCT_TYPE_ID,
      seriesId:
        parsed.prefix.toLowerCase(),
      cardTitle: {
        zh:
          parsed.structure,
        en:
          parsed.structure,
      },
      cardSubtitle: {
        zh:
          createCardSubtitle(
            parsed
          ),
        en:
          createCardSubtitle(
            parsed
          ),
      },
      filters,
      imageCard,
      detailSlug:
        slug,
      status:
        "active",
      sortOrder:
        index + 1,
      searchKeywords: {
        zh: [
          record.fullModel,
          model,
          record.productCode,
          record.itemNumber,
          record.sourceProductType,
          parsed.prefix,
          parsed.structure,
          ...parsed.threads,
          parsed.diameter,
          parsed.material,
          parsed.color,
        ]
          .filter(Boolean)
          .join(" "),
