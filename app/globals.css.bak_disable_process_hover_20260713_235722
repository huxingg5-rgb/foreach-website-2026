  border-top: 1px solid rgba(23, 51, 104, 0.08);
}

.site-footer__bottom-inner {
  width: min(100%, var(--content-max));
  margin: 0 auto;
  padding: 18px 24px 22px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24px;
  flex-wrap: wrap;
}

.site-footer__bottom-left {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 24px;
}

.site-footer__bottom-left p {
  margin: 0;
  color: var(--text-muted);
  font-size: 12px;
  line-height: 1.6;
}

/* =========================================================
   闂傚倸鍊搁崐鎼佸磹妞嬪海鐭嗗〒姘ｅ亾妤犵偛顦甸弫宥夊礋椤掆偓鎼村﹪姊虹粙鎸庢拱缂侇喖閰ｉ幆宀勫箻缂佹ê鈧敻鏌涢…鎴濅簽闁硅棄鍟埞鎴︻敊閽樺鏋欓梺鍝勭灱閸犳挾妲愰幒鎳崇喐娼弶鍨亖闂傚倷鐒﹂幃鍫曞磹閺嶎灐娲偄閸忕厧浜楀銈嗗姧缁犳垿鎮欐繝鍥ㄧ厪濠电倯鈧崑鎾绘煛鐎ｎ偅顥堟慨濠呮缁瑥鈻庨幆褍澹夐梻浣告贡閹虫挸煤閵堝鍋╅柣鎴ｆ缁犺櫕淇婇妶鍕槮闁逞屽墰閸忔﹢寮婚悢铏圭＜婵☆垵娅ｉ鍕磽?
